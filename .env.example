# --- Slack (from https://api.slack.com/apps -> your app) ---
# Basic Information -> Signing Secret
SLACK_SIGNING_SECRET=
# OAuth & Permissions -> Bot User OAuth Token
SLACK_BOT_TOKEN=xoxb-...
# Basic Information -> App-Level Tokens (scope: connections:write).
# Set it to run in Socket Mode. Leave empty to receive Slack requests over HTTP at PUBLIC_URL/slack/events.
SLACK_APP_TOKEN=xapp-...

# --- Each user connects their own ParaDev account (default) ---
# Public HTTPS URL of this app. ParaDev sends people back to PUBLIC_URL/oauth/callback after they sign in.
PUBLIC_URL=https://paradev-slack.fly.dev
# Encrypts the stored ParaDev tokens. Generate with: openssl rand -base64 32
# Losing it means everyone connects again; leaking it (with the store file) exposes their tokens.
TOKEN_ENCRYPTION_KEY=
# Where linked accounts are stored (encrypted). Put it on a persistent volume.
STORE_PATH=./data/store.json
# Optional: limit which Slack users may connect at all (comma-separated member IDs). Empty = anyone in the workspace.
ALLOWED_SLACK_USER_IDS=

# --- Or personal mode: one shared ParaDev API key ---
# Setting PARADEV_API_KEY switches to personal mode: every allowed Slack user acts as this key's owner,
# and ALLOWED_SLACK_USER_IDS becomes required. PUBLIC_URL and TOKEN_ENCRYPTION_KEY are then not needed.
# PARADEV_API_KEY=sk_live_...
# PARADEV_ORGANIZATION_ID=
# ALLOW_ANY_SLACK_USER=false

# --- Optional ---
# Harness preselected in the form (agent preset id)
DEFAULT_AGENT=claude
# Port for the HTTP server (sign-in callback, health check, and Slack requests in HTTP mode)
PORT=3000
# PARADEV_URL=https://api.superset.sh
# LOG_LEVEL=info
