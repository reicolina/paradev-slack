# --- Slack (from https://api.slack.com/apps -> your app) ---
# Basic Information -> Signing Secret
SLACK_SIGNING_SECRET=
# OAuth & Permissions -> Bot User OAuth Token
SLACK_BOT_TOKEN=xoxb-...
# Basic Information -> App-Level Tokens (scope: connections:write).
# Set it to run in Socket Mode (no public URL needed). Leave empty to run an HTTP server instead.
SLACK_APP_TOKEN=xapp-...

# --- ParaDev ---
# ParaDev desktop app -> Settings -> API Keys. Grants full access to your org: keep it secret.
PARADEV_API_KEY=sk_live_...
# Your ParaDev organization ID
PARADEV_ORGANIZATION_ID=

# --- Access control (required) ---
# Comma-separated Slack member IDs allowed to send jobs (Slack profile -> ... -> Copy member ID).
# Everyone else sees "not allowed". The app will not start while this is empty.
ALLOWED_SLACK_USER_IDS=
# Set to true only if everyone in the Slack workspace may use your ParaDev key.
# ALLOW_ANY_SLACK_USER=false

# --- Optional ---
# Harness preselected in the modal (agent preset id)
DEFAULT_AGENT=claude
# HTTP mode only
PORT=3000
