{
  "name": "paradev-slack",
  "version": "0.1.0",
  "description": "Slack message shortcut that sends a Slack message to a ParaDev workspace and starts an AI agent on it.",
  "license": "MIT",
  "type": "module",
  "main": "src/index.js",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "node src/index.js",
    "dev": "node --watch --env-file=.env src/index.js",
    "test": "node --test test/"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/reicolina/paradev-slack.git"
  },
  "keywords": ["slack", "paradev", "superset", "ai-agents", "claude", "bolt"],
  "dependencies": {
    "@slack/bolt": "^5.1.0",
    "@superset_sh/sdk": "0.0.1-alpha.12"
  }
}
